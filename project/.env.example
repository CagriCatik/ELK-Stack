# Pinned Elastic Stack version (no :latest tags)
ELASTIC_VERSION=8.17.4

# Local-only host bindings (127.0.0.1)
ES_HOST_PORT=9200
KIBANA_HOST_PORT=5601
LOGSTASH_HTTP_PORT=8080

# JVM heap sizes for local demo (adjust if host RAM is constrained)
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms512m -Xmx512m
