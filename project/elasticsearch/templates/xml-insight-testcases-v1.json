{
  "index_patterns": ["xml-insight-testcases-v1*"],
  "priority": 100,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": { "type": "date" },
        "doc_type": { "type": "keyword" },
        "synthetic": { "type": "boolean" },
        "campaign": { "properties": { "id": { "type": "keyword" } } },
        "run": { "properties": { "id": { "type": "keyword" }, "normalized_result": { "type": "keyword" } } },
        "execution_slot_id": { "type": "keyword" },
        "test_bench": { "properties": { "id": { "type": "keyword" } } },
        "project": { "type": "keyword" },
        "software": { "properties": { "version": { "type": "keyword" } } },
        "suite": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "phase": { "type": "keyword" },
        "test_case": {
          "properties": {
            "id": { "type": "keyword" },
            "execution_id": { "type": "keyword" },
            "attempt": { "type": "integer" },
            "name": { "type": "keyword" },
            "sequence": { "type": "integer" },
            "has_stable_id": { "type": "boolean" },
            "is_first_attempt": { "type": "boolean" },
            "is_final_attempt": { "type": "boolean" },
            "is_retry": { "type": "boolean" }
          }
        },
        "source_result": { "type": "keyword" },
        "normalized_result": { "type": "keyword" },
        "error_category": { "type": "keyword" },
        "analysis_classification": { "type": "keyword" },
        "extracted_error_codes": { "type": "keyword" },
        "duration_ms": { "type": "long" },
        "started_at": { "type": "date" },
        "ended_at": { "type": "date" },
        "step_count": { "type": "integer" },
        "failed_step_count": { "type": "integer" },
        "msg_count": { "type": "integer" },
        "error_msg_count": { "type": "integer" },
        "error_trend": { "type": "keyword" },
        "artifact_paths": { "type": "keyword" },
        "comparability_limited": { "type": "boolean" },
        "data_quality_issues": { "type": "keyword" },
        "source_file": { "type": "keyword" },
        "file_sha256": { "type": "keyword" },
        "ingested_at": { "type": "date" }
      }
    }
  }
}
